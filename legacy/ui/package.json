{
  "name": "acme-legacy-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/base.css -o ../public/css/theme.css --minify",
    "build:islands": "vite build",
    "build": "npm run build:css && npm run build:islands",
    "watch:css": "tailwindcss -i ./src/css/base.css -o ../public/css/theme.css --watch",
    "watch:islands": "vite build --watch",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:islands\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "daisyui": "^4.12.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
